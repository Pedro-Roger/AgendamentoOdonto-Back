# Configuração do Servidor
PORT=3000
NODE_ENV=development

# URL de Conexão com o Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agendamento_odonto?schema=public
# Credenciais do Banco de Dados (Altere para valores fortes em produção)
DB_USER=
DB_PASSWORD=

# Chave secreta para assinatura dos tokens JWT (Mínimo de 32 caracteres)
JWT_SECRET=sua_chave_secreta_super_segura_de_no_minimo_32_caracteres

# Tempo de expiração do Token JWT (ex: 1d, 7d, 2h)
JWT_EXPIRES_IN=1d

# Origens permitidas pelo CORS (separadas por vírgula, não use '*')
CORS_ORIGIN=http://localhost:3001

# Token para criação do usuário master admin via rota /api/auth/bootstrap-master (Mínimo de 16 caracteres)
BOOTSTRAP_TOKEN=token_seguro_de_bootstrap_com_mais_de_16_caracteres

# Configurações AWS S3 (armazenamento de arquivos/assinaturas/prontuários)
AWS_ACCESS_KEY_ID=seu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=seu_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=nome_do_seu_bucket_s3
S3_PUBLIC_BASE_URL=https://nome_do_seu_bucket_s3.s3.amazonaws.com
